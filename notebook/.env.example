# Copier ce fichier en .env et adapter si besoin

DATA_DIR=./data

# LLM_PROVIDER=ollama    -> local, gratuit, offline (nécessite un serveur Ollama, ex. via docker-compose)
# LLM_PROVIDER=gemini    -> API Google Gemini, gratuite sans carte bancaire (recommandé pour un déploiement cloud gratuit)
# LLM_PROVIDER=anthropic -> API Claude, payante, nécessite une clé avec crédit
LLM_PROVIDER=gemini
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Gemini (Google AI Studio) : clé gratuite, sans carte bancaire, sur https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
