{
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/utilisateur", "destination": "/espace-utilisateur.html" },
    { "source": "/developpeur", "destination": "/espace-developpeur.html" }
  ]
}
