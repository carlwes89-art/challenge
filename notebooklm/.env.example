# Copier ce fichier en .env et adapter si besoin

DATA_DIR=./data

# LLM_PROVIDER=ollama  -> local, gratuit, offline (recommandé pour la démo)
# LLM_PROVIDER=anthropic -> API Claude, meilleure qualité, nécessite une clé
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
